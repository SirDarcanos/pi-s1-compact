{
  "name": "pi-s1-compact",
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Pi extension for classifier-driven context compaction and tool-output pruning, with persistent settings and original evidence retrieval",
  "keywords": ["pi-package", "pi-extension", "compaction", "context-management", "tool-output", "classifier", "ollama", "nimble"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirDarcanos/pi-s1-compact.git"
  },
  "homepage": "https://github.com/SirDarcanos/pi-s1-compact#readme",
  "bugs": { "url": "https://github.com/SirDarcanos/pi-s1-compact/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "license": "MIT",
  "author": "Nicola Mustone",
  "contributors": ["Nour Helmi", "tamaratran"],
  "engines": { "node": ">=24.0.0" },
  "pi": { "extensions": ["./extensions/s1-compact.ts"] },
  "files": ["extensions", "src", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE.md", "licenses"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:engine": "vitest run tests/engine.spec.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run test:engine",
    "check:compatibility": "node scripts/check-compatibility.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-agent-core": ">=1.0.0",
    "@earendil-works/pi-ai": ">=1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typebox": "^1.3.24",
    "vitest": "^5.0.3"
  }
}
